# GPU server access for the robot-PC scripts (cgd_server_link.sh, premap_to_server.sh, remote_view.sh, tag_check.sh).
# Copy to gpu_server.env and fill in (the real file is not committed).
ATHOME_GPU_HOST=<user>@<gpu-server-host>
ATHOME_GPU_PORT=<ssh-port>
ATHOME_GPU_KEY=$HOME/.ssh/<key-for-the-gpu-server>
